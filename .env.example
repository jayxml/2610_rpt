# SAP AI Core / Gen AI Hub credentials for the Predictive JIT workshop.
# Do NOT commit your completed `.env` file. It contains secrets.

# --- SAP AI Core service key (OAuth client credentials) ---

AICORE_AUTH_URL=<auth_url>/oauth/token
AICORE_CLIENT_ID=<client_id>
AICORE_CLIENT_SECRET=<client_secret>
AICORE_BASE_URL=<api_url>/v2
AICORE_RESOURCE_GROUP=<resource_group>

# --- Model deployments ---
# SAP-RPT-1.6 tabular prediction deployment. Used by Exercise 1A, 1B, and 2.
# Provide the deployment BASE URL; the notebooks append `/predict` automatically. 
RPT1_6_DEPLOYMENT_URL=<rpt1_6_deployment_url>

# Gen AI Hub orchestration deployment (LLM agent). Used by Exercise 2 only.
ORCH_DEPLOYMENT_URL=<orchestration_deployment_url>